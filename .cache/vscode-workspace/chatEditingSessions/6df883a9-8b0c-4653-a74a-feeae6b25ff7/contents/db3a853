"""Page de cartographie des zones protegees."""

import streamlit as st

from dashboard.common import load_key_data, render_global_filters
from src.analysis import summarize_protected_areas

st.set_page_config(page_title="Zones protegees", layout="wide")
st.title("Zones protegees et forets classees")
all_data = load_key_data()
data = all_data["areas"]
selected_region = render_global_filters(all_data)[2]
if selected_region is not None:
	data = data[data["region_nom_bdd"] == selected_region]
st.map(data[["centroid_lat", "centroid_lon"]].rename(columns={"centroid_lat": "lat", "centroid_lon": "lon"}))
st.caption("Les points representent les centroïdes des 53 zones; les surfaces sont calculees en projection UTM.")
st.dataframe(summarize_protected_areas(data), width="stretch", hide_index=True)
