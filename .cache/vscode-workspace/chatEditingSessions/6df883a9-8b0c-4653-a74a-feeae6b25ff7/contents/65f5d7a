"""Page de cartographie des zones protegees."""

import streamlit as st

from dashboard.common import load_key_data, render_filters, render_page_header, render_source, show_empty_message
from src.analysis import summarize_protected_areas
from src.analysis import add_vulnerability_score, summarize_protected_areas
from src.viz import protected_areas_map_figure, regional_zone_count_figure

st.set_page_config(page_title="Zones protegees", layout="wide")
st.title("Zones protégées | Togo AI Lab")
render_page_header("Zones protégées", "Localiser les 53 zones classées et comparer leur emprise par région.")
all_data = load_key_data()
data = all_data["areas"]
selected_region = render_global_filters(all_data)[2]
if selected_region is not None:
	data = data[data["region_nom_bdd"] == selected_region]
data = add_vulnerability_score(data)
if data.empty:
	show_empty_message()
else:
	col1, col2 = st.columns(2)
	col1.metric("Zones affichées", f"{len(data)}")
	col2.metric("Surface protégée", f"{data['surface_km2'].sum():.1f} km²")
	map_col, chart_col = st.columns([1.7, 1])
	with map_col:
		st.plotly_chart(protected_areas_map_figure(data), width="stretch")
	with chart_col:
		st.plotly_chart(regional_zone_count_figure(data), width="stretch")
	st.caption("Lecture : la couleur exprime un score relatif combinant surface et concentration régionale des zones; ce n'est pas un diagnostic écologique de terrain.")
	render_source("file-zones-protegees-forets-classees-*.csv, données géographiques WGS84")
st.dataframe(summarize_protected_areas(data), width="stretch", hide_index=True)
